# Copy to .env and fill in. .env is gitignored.

# Preview | Preprod | Mainnet
CARDANO_NETWORK=Preview

# Free key from https://blockfrost.io -- create a project on the SAME network
BLOCKFROST_PROJECT_ID=preview...

# Generate with: deno task wallet
# Testnet only. Never put a mainnet seed phrase here.
WALLET_SEED_PHRASE=

# Optional bidder wallets, numbered from 1. Generate with `deno task wallet`.
# Without any of these the seller bids on their own auction: it works, but
# demonstrates less. Two bidders is the interesting configuration -- one
# displacing the other is what exercises the refund path against a stranger
# whose address the contract carries in its datum.
BIDDER1_SEED_PHRASE=
BIDDER2_SEED_PHRASE=

# MariaDB, for the indexer and the read-only API only. Nothing that signs a
# transaction needs these -- the database is a derived cache of public chain
# data, not part of the path that moves money.
# Create the database and user with:  sudo mariadb < sql/setup.sql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=auction
DB_PASSWORD=auction
DB_NAME=auction_indexer
