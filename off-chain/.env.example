# Copy to .env and fill in. .env is gitignored.

# Preview | Preprod | Mainnet
CARDANO_NETWORK=Preview

# Free key from https://blockfrost.io -- create a project on the SAME network
BLOCKFROST_PROJECT_ID=preview...

# Generate with: deno task wallet
# Testnet only. Never put a mainnet seed phrase here.
WALLET_SEED_PHRASE=
