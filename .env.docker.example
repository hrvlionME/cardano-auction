# For docker compose. Copy to .env (next to docker-compose.yml) and fill in.
# No seed phrases here: the server never needs one.

# Preview | Preprod | Mainnet
CARDANO_NETWORK=Preview
BLOCKFROST_PROJECT_ID=preview...

# The address you type into the browser. It is part of the message a wallet
# signs at sign-in, so it must match exactly, e.g. http://192.168.1.20:8000
SITE_ORIGIN=http://localhost:8000
PORT=8000

DB_PASSWORD=auction
DB_ROOT_PASSWORD=auction-root
